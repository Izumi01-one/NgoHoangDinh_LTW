@using Week15_de1_ontap.Models;
@inject QltaiSanContext _context;
<header class="header">
    <div class="topbar">
        <div class="container">
            <span>Phòng Hành chính - Quản trị: <b>(024) 3999 8888</b> &nbsp;|&nbsp; Hỗ trợ: taisan@assethub.vn</span>
            <span>Xin chào, Quản trị viên &nbsp;|&nbsp; Đăng xuất</span>
        </div>
    </div>
    <div class="header-main">
        <div class="container">
            <a href="index.html"><img src="images/logo.png" alt="AssetHub" /></a>
            <div class="cart-box">Tổng tài sản: 16 - Nguyên giá: 3.125 triệu</div>
        </div>
    </div>
    <nav class="navbar">
        <div class="container">
            <ul class="menu">
                <li class="active"><a href="#">Ngô Hoàng Đỉnh</a></li>
                @foreach(var ts in _context.LoaiTaiSans.ToList())
                {
                    <li><a href="javascript:void(0)" onclick="loctaisan(@ts.MaLoai, '@ts.TenLoai')">@ts.TenLoai</a></li>
                }

                
            </ul>
            <form class="search-box">
                <input type="text" placeholder="Tìm tài sản..." />
                <button type="button">Tìm</button>
            </form>
        </div>
    </nav>
</header>