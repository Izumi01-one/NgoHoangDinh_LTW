@{
    ViewData["Title"] = "Index";
    var products = ViewBag.Products;
}

<div class="row">
	@foreach (var item in products)
	{
		<div class="col-md-3">
			<div class="thumbnail">
				<img src="@item.Image" alt="" style="width:100%" />
				<div class="caption">
					<h3>@item.Name</h3>
					<p>Giá : @item.Price</p>
					<p>Giá : @item.SalePrice</p>
					<p>
						<a asp-route="product" asp-route-id="@item.Id" class="btn btn-success btn-block">Chi tiết</a>
					</p>
				</div>
			</div>
		</div>
	}

    
    
</div>
