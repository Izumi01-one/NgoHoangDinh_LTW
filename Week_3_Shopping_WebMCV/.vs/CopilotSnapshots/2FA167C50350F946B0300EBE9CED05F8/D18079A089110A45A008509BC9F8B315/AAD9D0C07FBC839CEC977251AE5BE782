@{
    ViewData["Title"] = "Index";
    var products = ViewBag.Products;
    var categories = ViewBag.Categories;
    int? selectedCategoryId = ViewBag.SelectedCategoryId;
}

<div class="row">
    <div class="col-md-3">
        <h2>Danh mục</h2>
        <div class="list-group">
            <a asp-controller="Product" asp-action="Index"
               class="list-group-item list-group-item-action @(selectedCategoryId == null ? "active" : "")">
                Tất cả sản phẩm
            </a>
            @foreach (var category in categories)
            {
                <a asp-controller="Product" asp-action="Index" asp-route-categoryId="@category.Id"
                   class="list-group-item list-group-item-action @(selectedCategoryId == category.Id ? "active" : "")">
                    @category.Name
                </a>
            }
        </div>
    </div>

    <div class="col-md-9">
        <h1>Danh sách sản phẩm</h1>
        <div class="row">
            @if (!products.Any())
            {
                <div class="col-12">
                    <p>Danh mục này chưa có sản phẩm.</p>
                </div>
            }
            else
            {
                @foreach (var item in products)
                {
                    <div class="col-md-4 mb-4">
                        <div class="thumbnail">
                            <img src="@item.Image" alt="@item.Name" style="width:100%" />
                            <div class="caption">
                                <h3>@item.Name</h3>
                                <div style="display:inline-block">
                                    <p class="text-decoration-line-through">Giá gốc : @item.Price</p>
                                    <p>Giá : @item.SalePrice</p>
                                    <p>
                                        <a asp-route="product" asp-route-id="@item.Id" class="btn btn-success btn-block">Chi tiết</a>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>
