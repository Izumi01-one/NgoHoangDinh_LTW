@{
    ViewData["Title"] = "Danh sách sản phẩm";

    var products = ViewBag.Products;
    var categories = ViewBag.Categories;
    int? selectedCategoryId = ViewBag.SelectedCategoryId;
}

<div class="row">
    <!-- Bảng danh mục -->
    <div class="col-md-3">
        <h3>DANH MỤC</h3>

        <div class="list-group">
            <a asp-route="product"
               class="list-group-item list-group-item-action">
                Tất cả sản phẩm
            </a>

            @foreach (var category in categories)
            {
                <a asp-route="category"
                   asp-route-categoryId="@category.Key"
                   class="list-group-item list-group-item-action
                    @(selectedCategoryId == category.Key ? "active" : "")">
                    @category.Value
                </a>
            }
        </div>
    </div>

    <!-- Danh sách sản phẩm -->
    <div class="col-md-9">
        <h1>Danh sách sản phẩm</h1>

        <div class="row">
            @if (products != null && products.Count > 0)
            {
                @foreach (var item in products)
                {
                    <div class="col-md-4 mb-4">
                        <div class="card h-100">
                            <img src="@item.Image"
                                 class="card-img-top"
                                 alt="@item.Name"
                                 style="height: 250px; object-fit: cover;" />

                            <div class="card-body">
                                <h3 class="card-title">@item.Name</h3>

                                <div class="d-flex gap-2">
                                    <p class="text-decoration-line-through">
                                        Giá gốc: @item.Price.ToString("N0")
                                    </p>

                                    <p class="text-danger">
                                        Giá: @item.SalePrice.ToString("N0")
                                    </p>
                                </div>

                                <a asp-route="productDetail"
                                   asp-route-id="@item.Id"
                                   class="btn btn-success w-100">
                                    Chi tiết
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12">
                    <div class="alert alert-warning">
                        Danh mục này chưa có sản phẩm.
                    </div>
                </div>
            }
        </div>
    </div>
</div>