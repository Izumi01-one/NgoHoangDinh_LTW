@model IEnumerable<NgoHoangDinh_241230706.Models.Sach>
@{
}

@foreach(var sach in Model)
{
    <div class="book-card">
        <a href="#"><img src="images/@sach.Anh" alt="" /></a>
        <h2>@sach.TenSach</h2>
        <div class="book-foot">
            <span class="price">@sach.Gia</span>
            <button class="btn-buy">Thêm vào giỏ</button>
        </div>
    </div>
}