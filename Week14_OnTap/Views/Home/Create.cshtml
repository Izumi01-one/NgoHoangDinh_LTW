@model NgoHoangDinh_241230706.Models.Sach


<div class="container" style="margin-top:20px; margin-bottom:40px">
    <div class="section-head">
        <h3>Ngô Hoàng Đỉnh - Thêm sách mới</h3>
    </div>

    <form asp-action="Create" method="post">
        <div style="margin-bottom: 12px">
            <label>MaTL</label><br />
            <select asp-for="MaTl" asp-items="ViewBag.MaTl" style="width:100%; padding:6px;"></select>
            <span asp-validation-for="MaTl" style="color:red"></span>
        </div>

        <div style="margin-bottom: 12px">
            <label>TenSach</label><br />
            <input asp-for="TenSach" style="width:100%; padding:6px;"></input>
            <span asp-validation-for="TenSach" style="color:red"></span>
        </div>

        <div style="margin-bottom: 12px">
            <label>Gia</label><br />
            <input asp-for="Gia" style="width:100%; padding:6px;"></input>
            <span asp-validation-for="Gia" style="color:red"></span>
        </div>

        <div style="margin-bottom: 12px">
            <label>Anh</label><br />
            <input asp-for="Anh" style="width:100%; padding:6px;"></input>
            <span asp-validation-for="Anh" style="color:red"></span>
        </div>

        <button type="submit" style="padding:6px;">Create</button>
    </form>

</div>



