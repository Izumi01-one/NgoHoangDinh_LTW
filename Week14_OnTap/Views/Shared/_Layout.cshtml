@using NgoHoangDinh_241230706.Models;
@inject AppDbContext _context
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @* <title>@ViewData["Title"] - NgoHoangDinh_241230706</title> *@
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/NgoHoangDinh_241230706.styles.css" asp-append-version="true" />
    <title>BookHub - Nhà sách trực tuyến</title>
    <link href="~/css/layout.css" rel="stylesheet" type="text/css"/>
    <link href="~/css/style.css" rel="stylesheet" type="text/css"/>

</head>
<body>
    <header class="header">
        <div class="topbar">
            <div class="container">
                <span>Hotline: <b>1900 6789</b> &nbsp;|&nbsp; Miễn phí vận chuyển đơn từ 300.000đ</span>
                <span>Đăng nhập &nbsp;|&nbsp; Đăng ký</span>
            </div>
        </div>
        <div class="header-main">
            <div class="container">
                <a href="index.html"><img src="images/logo.png" alt="BookHub" /></a>
                <div class="cart-box">Giỏ hàng: 0 sản phẩm - 0đ</div>
            </div>
        </div>
        <nav class="navbar">
            <div class="container">
                <ul class="menu">
                    <li class="active">
                        <a asp-controller="Home" asp-action="Index">Ngô Hoàng Đỉnh</a>
                    </li>
                    @foreach(var tl in _context.TheLoais.ToList())
                    {
                        <li>
                            <a href="javascript:void(0)" onclick="locsach(@tl.MaTl, '@tl.TenTl')">@tl.TenTl</a>
                        </li> 
                    }

                </ul>
                <form class="search-box">
                    <input type="text" placeholder="Tìm sách..." />
                    <button type="button">Tìm</button>
                </form>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    @* <footer class="footer">
        <div class="container">
            <div class="grid">
                <div><h4>Về BookHub</h4><ul><li><a href="#">Giới thiệu</a></li><li><a href="#">Tuyển dụng</a></li><li><a href="#">Hệ thống cửa hàng</a></li></ul></div>
                <div><h4>Hỗ trợ khách hàng</h4><ul><li><a href="#">Hướng dẫn mua hàng</a></li><li><a href="#">Chính sách đổi trả</a></li><li><a href="#">Bảo mật thông tin</a></li></ul></div>
                <div><h4>Tài khoản</h4><ul><li><a href="#">Đăng nhập</a></li><li><a href="#">Giỏ hàng</a></li><li><a href="#">Sách yêu thích</a></li></ul></div>
                <div><h4>Liên hệ</h4><ul><li>Hotline: 1900 6789</li><li>Email: cskh@bookhub.vn</li></ul></div>
            </div>
            <div class="copyright">&copy; 2026 BookHub. Template phục vụ đề thi mẫu.</div>
        </div>
    </footer>  *@


    <div class="to-top">&uarr;</div>
    <script src="js/jquery.min.js"></script>
    <script src="js/main.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
<script>
    function locsach(maTl, tenTl) {
        $("#tieude").text(tenTl);
        $.get("/Home/LocSach", { maTl : maTl }, function (data) {
            $("#ds_sach").html(data);
        });
    }
</script>
</html>
