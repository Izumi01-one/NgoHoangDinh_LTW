@model IEnumerable<NgoHoangDinh_241230706_ontap.Models.HangHoa>

@{
    ViewData["Title"] = "Home Page";
    Layout = "_NgoHoangDinh_Layout";
}

<div class="main">
	<div class="content">
		<!-- Begin New Product -->
		<div class="content_top">
			<div class="heading">
				<h3 id="tieude">Ngô Hoàng Đỉnh</h3>
			</div>
			<div class="see">
				<p><a href="#">See all Products</a></p>
			</div>
			<div class="clear"></div>
		</div>
		<div class="section group" id="ds_hang">
			@foreach(var hh in Model)
			{
				<div class="grid_1_of_4 images_1_of_4">
					<a href="preview.html"><img src="~/images/@hh.Anh" alt="" /></a>
					<h2>@hh.TenHang</h2>
					<div class="price-details">
						<div class="price-number">
							<p><span class="rupees">$@hh.Gia</span></p>
						</div>
						<div class="add-cart">
							<h4><a href="preview.html">Add to Cart</a></h4>
						</div>
						<div class="clear"></div>
					</div>
				</div>
			}

			
		</div>
		<!-- End New Product -->
		<!-- Begin Feature Products -->
		
		<!-- End Feature Products -->
	</div>
</div>