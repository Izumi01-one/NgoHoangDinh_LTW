@model IEnumerable<Week_6_Models_WebMCV.Models.User>
@{
    ViewData["Title"] = "User Index";
    
}

@foreach(var u in Model)
{
    <div>
        <p>Name : @u.name</p>
        <p>Address: @u.address</p>
        <p>Email: @u.email</p>
        <br />
    </div>
}

