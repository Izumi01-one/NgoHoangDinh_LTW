@model Week_6_Models_WebMCV.Models.User
@{
    ViewBag.Title = "Details";
}
<h2>Details</h2>
<div>
    <h4>User</h4>
    <hr />
    <dl class="dl-horizontal">
        <dt>Name</dt>
        <dd>@Model.name</dd>
        <dt>Address</dt>
        <dd>@Model.address</dd>
        <dt>Email</dt>
        <dd>@Model.email</dd>
    </dl>
</div>
<p>
    @Html.ActionLink("Edit", "Edit", new { id = Model.Id }) |
    @Html.ActionLink("Back to List", "Users")
</p>