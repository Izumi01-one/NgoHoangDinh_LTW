@model IEnumerable<Week_6_Models_WebMCV.Models.User>
@{
    ViewBag.Title = "Users";
}

<h2>Users</h2>
<p>@Html.ActionLink("Create New", "Create")</p>
<table class="table">
    <tr>
        <th>Name</th>
        <th>Address</th>
        <th>Email</th>
        <th></th>
    </tr>
@foreach(var item in Model) {
    <tr>
        <td>@item.name</td>
        <td>@item.address</td>
        <td>@item.email</td>
        <td>
            @Html.ActionLink("Details", "Details", new { id = item.Id }) |
            @Html.ActionLink("Edit", "Edit", new { id = item.Id })
        </td>
    </tr>
}
</table>