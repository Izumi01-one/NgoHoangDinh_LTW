@model IEnumerable<Week_6_WebMCV.Models.Member>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.MemberUserName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MemberPassword)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MemberEmail)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MemberFullName)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.MemberUserName)
            </td>
            <td>
                @Html.DisplayFor(model => item.MemberPassword)
            </td>
            <td>
                @Html.DisplayFor(model => item.MemberEmail)
            </td>
            <td>
                @Html.DisplayFor(model => item.MemberFullName)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.MemberId">Sửa</a> |
                <a asp-action="Details" asp-route-id="@item.MemberId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.MemberId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
